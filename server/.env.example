# ─────────────────────────────────────────────
# 이 파일을 복사해서 .env 파일을 만들고
# 실제 값으로 채워서 사용하세요
# (.env 파일은 절대 Git에 올리면 안 됩니다)
# ─────────────────────────────────────────────

# MySQL 연결 URL
# Railway: 대시보드 > MySQL 서비스 > Variables 탭에서 복사
# 형식: mysql://유저명:비밀번호@호스트:포트/DB이름
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT 시크릿 키
# 길고 예측 불가능한 문자열로 설정 (예: openssl rand -base64 32 로 생성)
JWT_SECRET="여기에-복잡한-시크릿-키를-입력하세요"

# JWT 만료 시간 (7d = 7일, 1h = 1시간)
JWT_EXPIRES_IN="7d"

# 서버 포트 (Railway에서는 자동으로 PORT 환경변수를 주입해줍니다)
PORT=3000
